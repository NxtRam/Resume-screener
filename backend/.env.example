# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google GenAI (Gemini)
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# CORS — Set this to your deployed Vercel frontend URL
PUBLIC_URL=https://your-frontend.vercel.app

# Optional: Redis URL (if using Redis-backed queue — e.g. Upstash or Render Redis)
# Leave empty to use in-memory queue (resets on restart)
REDIS_URL=

# Port (automatically set by Render in production)
PORT=3000
